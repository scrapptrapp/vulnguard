<Window x:Class="VulnGuard_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VulnGuard"
        Icon="app_icon.ico" 
        Width="860" Height="600"
        MinWidth="860" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize">

    <Window.Resources>

        <DropShadowEffect x:Key="GreenGlow"   Color="#00FF41" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
        <DropShadowEffect x:Key="GreenGlowSoft" Color="#00FF41" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="RedGlow"     Color="#FF2222" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>

        <Style x:Key="BracketButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#00FF41"/>
            <Setter Property="FontFamily"      Value="Courier New"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Effect"          Value="{StaticResource GreenGlowSoft}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0A1F0A"/>
                                <Setter Property="Effect"     Value="{StaticResource GreenGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed"   Value="True">
                                <Setter Property="Background" Value="#142814"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"   Value="False">
                                <Setter Property="Opacity"   Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBarButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#00FF41"/>
            <Setter Property="FontFamily"      Value="Courier New"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0A1F0A"/>
                                <Setter Property="Effect"     Value="{StaticResource GreenGlowSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity"  Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#00FF41" BorderThickness="1" Effect="{StaticResource GreenGlowSoft}">
        <Border.Background>
            <ImageBrush ImageSource="pack://application:,,,/bg.jpg" Stretch="UniformToFill"/>
        </Border.Background>

        <Grid Background="#66000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ══ TITLE BAR ══ -->
            <Border Grid.Row="0" Background="#B0000000" BorderBrush="#00FF41" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="app_icon.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                        
                        <TextBlock Text="☣ VULNGUARD :: BREACH_SCANNER"
                                Foreground="#00FF41" FontFamily="Courier New" FontSize="11" FontWeight="Bold"
                                VerticalAlignment="Center" Effect="{StaticResource GreenGlowSoft}"/>
                        
                        <Button x:Name="MuteBtn" Content="🔊" Click="Mute_Click"
                                Style="{StaticResource TopBarButton}" FontSize="12" Padding="8,3" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,8,0" HorizontalAlignment="Right">
                        <Button x:Name="ScanQuickBtn" Content="[ QUICK SCAN ]"
                                Style="{StaticResource TopBarButton}" Margin="0,0,6,0" Click="ScanQuick_Click"/>
                        <Button x:Name="AboutBtn" Content="[ ABOUT ]"
                                Style="{StaticResource TopBarButton}" Margin="0,0,6,0" Click="About_Click"/>
                        <Button Content="—" Style="{StaticResource TopBarButton}" Margin="0,0,4,0" Click="Min_Click"/>
                        <Button Content="✕" Style="{StaticResource TopBarButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ LOGO HEADER ══ -->
            <Border Grid.Row="1" Background="#99000000" BorderBrush="#00FF41" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="⬡  VULNGUARD  ⬡"
                               Foreground="#00FF41" FontFamily="Courier New" FontSize="32" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Effect="{StaticResource GreenGlow}"/>
                    <TextBlock Text="LOCAL VULNERABILITY SCANNER + AUTO-PATCH"
                               Foreground="#005F18" FontFamily="Courier New" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </Grid>
            </Border>

            <!-- ══ BODY ══ -->
            <Grid Grid.Row="2" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Action buttons -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="20,16,12,12" VerticalAlignment="Top">
                    <Button x:Name="FullScanBtn" Content="[ RUN FULL VULNERABILITY SCAN ]"
                            Style="{StaticResource BracketButton}" Margin="0,0,0,10" Click="FullScan_Click"/>
                    <Button x:Name="AutoFixBtn" Content="[ AUTO-PATCH ALL FIXABLE ISSUES ]"
                            Style="{StaticResource BracketButton}" Margin="0,0,0,10" IsEnabled="False" Click="AutoFix_Click"/>
                    <Button x:Name="FirewallBtn" Content="[ HARDEN FIREWALL ]"
                            Style="{StaticResource BracketButton}" Margin="0,0,0,10" Click="Firewall_Click"/>
                    <Button x:Name="SshBtn" Content="[ LOCK DOWN SSH ]"
                            Style="{StaticResource BracketButton}" Margin="0,0,0,10" Click="Ssh_Click"/>
                    <Button x:Name="KernelBtn" Content="[ HARDEN KERNEL PARAMS ]"
                            Style="{StaticResource BracketButton}" Margin="0,0,0,10" Click="Kernel_Click"/>
                    <Button x:Name="RestoreBtn" Content="[ RESTORE DEFAULTS ]"
                            Style="{StaticResource BracketButton}" Margin="0,0,0,0" Click="Restore_Click"/>
                </StackPanel>

                <!-- Status panel -->
                <Border Grid.Column="1" Margin="0,16,20,12" BorderBrush="#00FF41" BorderThickness="1" Background="#B0000000">
                    <StackPanel Margin="14,12">

                        <TextBlock Text="SYSTEM STATUS" Foreground="#005F18" FontFamily="Courier New"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Ellipse x:Name="StatusLight" Width="14" Height="14" Fill="#00FF41"
                                     Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00FF41" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Text="IDLE" Foreground="#00FF41"
                                       FontFamily="Courier New" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center" Effect="{StaticResource GreenGlowSoft}"/>
                        </StackPanel>

                        <Separator Background="#00FF41" Opacity="0.2" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="HIGH"   Foreground="#FF2222" FontFamily="Courier New" FontSize="11"/>
                            <TextBlock Grid.Column="1" x:Name="CountHigh" Text="0" Foreground="#FF2222" FontFamily="Courier New" FontSize="11" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MEDIUM" Foreground="#FFAA00" FontFamily="Courier New" FontSize="11"/>
                            <TextBlock Grid.Column="1" x:Name="CountMed"  Text="0" Foreground="#FFAA00" FontFamily="Courier New" FontSize="11" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PASSED" Foreground="#00FF41" FontFamily="Courier New" FontSize="11"/>
                            <TextBlock Grid.Column="1" x:Name="CountOk"   Text="0" Foreground="#00FF41" FontFamily="Courier New" FontSize="11" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FIXABLE" Foreground="#00AAFF" FontFamily="Courier New" FontSize="11"/>
                            <TextBlock Grid.Column="1" x:Name="CountFix"  Text="0" Foreground="#00AAFF" FontFamily="Courier New" FontSize="11" FontWeight="Bold"/>
                        </Grid>

                        <Separator Background="#00FF41" Opacity="0.2" Margin="0,0,0,10"/>

                        <TextBlock Text="SCAN PROGRESS" Foreground="#005F18" FontFamily="Courier New" FontSize="9" Margin="0,0,0,5"/>
                        <Border x:Name="ScanProgressTrack" BorderBrush="#00FF41" BorderThickness="1" Height="12" Background="#80000000">
                            <Grid>
                                <Rectangle x:Name="ScanProgress" Fill="#00FF41" HorizontalAlignment="Left" Width="0">
                                    <Rectangle.Effect>
                                        <DropShadowEffect Color="#00FF41" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                    </Rectangle.Effect>
                                </Rectangle>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="ScanProgressText" Text="0%" Foreground="#005F18"
                                   FontFamily="Courier New" FontSize="9" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                        <TextBlock x:Name="LastScanLabel" Text="LAST SCAN: NEVER" Foreground="#003A0F"
                                   FontFamily="Courier New" FontSize="9" Margin="0,8,0,0"/>
                        <TextBlock x:Name="ReportPathLabel" Text="" Foreground="#003A0F"
                                   FontFamily="Courier New" FontSize="8" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ CONSOLE LOG ══ -->
            <Border Grid.Row="3" Margin="20,0,20,10" BorderBrush="#00FF41" BorderThickness="1" Background="#A8000000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#A0000A00" BorderBrush="#00FF41" BorderThickness="0,0,0,1">
                        <TextBlock Text="// TERMINAL OUTPUT" Foreground="#005F18" FontFamily="Courier New"
                                   FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Background="Transparent" Padding="8,6">
                        <TextBlock x:Name="ConsoleLog" Foreground="#00FF41" FontFamily="Courier New"
                                   FontSize="11" TextWrapping="Wrap" Background="Transparent"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ STATUS BAR ══ -->
            <Border Grid.Row="4" Background="#A0000A00" BorderBrush="#00FF41" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <TextBlock Text="VulnGuard v1.0 :: Run as Administrator for full scan"
                               Foreground="#003A0F" FontFamily="Courier New" FontSize="9" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="TrayLight" Width="8" Height="8" Fill="#00FF41" Margin="0,0,6,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00FF41" BlurRadius="6" ShadowDepth="0" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="TrayText" Text="STANDING BY" Foreground="#00FF41"
                                   FontFamily="Courier New" FontSize="9" Effect="{StaticResource GreenGlowSoft}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
