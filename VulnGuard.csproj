<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VulnGuard</AssemblyName>
    <RootNamespace>VulnGuard</RootNamespace>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="ambient_bg.mp3" />
    <None Remove="scanning_loop.mp3" />
    <None Remove="bg.jpg" />
    <None Remove="app_icon.ico" />
    <Resource Include="ambient_bg.mp3" />
    <Resource Include="scanning_loop.mp3" />
    <Resource Include="bg.jpg" />
    <Resource Include="app_icon.ico" />
  </ItemGroup>

</Project>
